# Copy to config/.env and adjust for your machine. Never commit a real password.
# V2 reuses the V1 database but only touches the isolated `search_v2` schema.
DATABASE_URL=postgresql://ai_search@127.0.0.1:5432/ai_search
API_HOST=127.0.0.1
API_PORT=8001

DB_POOL_MIN=2
DB_POOL_MAX=8
REQUEST_DEADLINE_MS=950

# Embedding model profile (see app/embedding.py). Files live in MODELS_DIR/<model>/
# Download with: python -m scripts.download_model bge-small-en-v1.5
EMBED_MODEL=bge-small-en-v1.5
EMBED_THREADS=2
EMBED_CONCURRENCY=2
DENSE_ENABLED=true
TEXT_VERSION=tv2-2
# CALIBRATION_FILE=C:/path/to/calibration.json  # optional; default config/calibration.json
# DENSE_MIN_SIMILARITY=      # leave empty until calibrated on your real catalog

# Document construction
PASSAGE_TOKENS=384
PASSAGE_OVERLAP_SENTENCES=0
SCENE_CONTEXT_HEADER=false

# Lexical: ts_rank_cd | ts_rank, normalisation flag, AND -> relaxed OR fallback
LEX_RANK_FN=ts_rank_cd
LEX_RANK_NORM=1
LEX_RELAX=true
LEX_MIN_CANDIDATES=5
LEX_MIN_MATCH_RATIO=0.5   # relaxed stages must match this share of the query terms

# Fusion: weighted RRF. WEIGHT_PROFILE=catalog_preferred | equal
CANDIDATE_WINDOW=50
DENSE_CANDIDATES=1000     # nearest documents grouped by title before the window is applied
RRF_K=60
WEIGHT_PROFILE=catalog_preferred
CATALOG_CHANNEL_WEIGHT=1.0
SCENE_CHANNEL_WEIGHT=0.5
MULTI_SCENE_BONUS=0.0

# Reranker (off until it passes the release gate)
RERANK_ENABLED=false
RERANK_DEPTH=20

# Optional for private GCS video playback (Application Default Credentials otherwise)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
