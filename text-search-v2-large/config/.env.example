# Reuse the existing DB; schema is fixed to schema_v2_large.
LARGE_DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@127.0.0.1:5432/YOUR_DATABASE
API_HOST=127.0.0.1
API_PORT=8002
EMBED_MODEL=bge-small-en-v1.5
# MODELS_DIR=/path/to/parent/containing/bge-small-en-v1.5
DENSE_ENABLED=true
EMBED_THREADS=2
EMBED_CONCURRENCY=2
LEXICAL_WEIGHT=1.0
SEMANTIC_WEIGHT=1.0
REQUEST_DEADLINE_MS=950
GENERATION_CHECK_SECONDS=2
# No demo dense cutoff is installed. Calibrate on this actual corpus.
